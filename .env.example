# ---------------------------------------------------------------------------
# SIMVERSE environment configuration (example)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All variables are validated at startup by src/lib/env.ts.
# ---------------------------------------------------------------------------

# Database connection string.
# Phase 0 uses SQLite for zero-setup local development:
#   DATABASE_URL="file:./prisma/dev.db"
# The schema is written to be portable; to move to PostgreSQL later, switch the
# datasource provider to "postgresql" and set a Postgres URL, e.g.:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/simverse?schema=public"
DATABASE_URL=

# Secret used to derive session-token hashes (HMAC pepper) and other signing.
# Must be a long, random string (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public-facing application name (safe to expose to the client).
NEXT_PUBLIC_APP_NAME=SIMVERSE

# Base URL of the application (used for absolute links / cookies in production).
APP_URL=http://localhost:3000

# OPTIONAL: Universal Marketplace private GLB storage pilot.
# Must be an ABSOLUTE path to a persistent disk mounted into the Node server.
# Never point at /public, .next, or a disposable serverless /tmp.
# If unset, private file uploads are disabled (not silently simulated).
# Example Windows: SIMVERSE_MARKETPLACE_STORAGE_DIR=D:/SIMVERSE_DATA/private-marketplace
# Example Linux: SIMVERSE_MARKETPLACE_STORAGE_DIR=/srv/simverse-marketplace-private
# SIMVERSE_MARKETPLACE_STORAGE_DIR=
