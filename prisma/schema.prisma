// Prisma schema for SIMVERSE — Phase 0 (Platform foundation).
//
// DATABASE NOTE:
//   Phase 0 targets SQLite for zero-setup local development. The schema is
//   intentionally written to be portable to PostgreSQL:
//     * No SQLite-only column types are used.
//     * Role / action values are stored as String and validated in the app
//       layer (src/lib/permissions) because SQLite has no native enums. On a
//       Postgres migration these can become native enums with a simple ALTER.
//     * AuditLog.metadata is a JSON string (portable) rather than a Json column.
//   To migrate: change datasource `provider` to "postgresql", point
//   DATABASE_URL at Postgres, then run `prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Connection URL lives in prisma.config.ts (Prisma 7 moved it out of the schema).
}

/// A platform user (account). Deliberately generic — no simulation/game stats live here.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  sessions        Session[]
  auditLogs       AuditLog[]        @relation("AuditActor")
  createdEntities Entity[]          @relation("EntityCreator")

  // Phase 2 — Projects & Simulation definitions authored by this user.
  createdProjects      Project[]       @relation("ProjectCreator")
  addedProjectEntities ProjectEntity[] @relation("ProjectEntityAdder")
  createdSimulations   Simulation[]    @relation("SimulationCreator")
}

/// A workspace: the primary tenant boundary. Users may belong to many workspaces.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  auditLogs AuditLog[]

  entities             Entity[]
  attributeDefinitions AttributeDefinition[]
  tags                 Tag[]
  projects             Project[]
  simulations          Simulation[]
}

/// Membership linking a user to a workspace with a role. Role governs permissions.
model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String // WorkspaceRole (OWNER|ADMIN|CREATOR|OPERATOR|EDITOR|ANALYST|VIEWER) — validated in app layer
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Server-side session. The cookie holds an opaque token; only its HMAC hash is stored.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only audit trail of significant platform actions.
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorUserId String?
  action      String // e.g. user.registered, user.logged_in, workspace.created, workspace.updated
  entityType  String?
  entityId    String?
  metadata    String? // serialized JSON (portable across SQLite/Postgres)
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([actorUserId])
  @@index([createdAt])
}

// ============================================================================
// ENTITY SYSTEM (Phase 1 — the generic, extensible object model)
//
// One architecture represents every kind of object a simulation might contain —
// Country, Robot, Animal, Vehicle, City, Farm, Business, Team, Person, Machine,
// Custom, … — WITHOUT a table per kind. `category` is a plain String key so the
// set of kinds is open-ended (an app-layer catalog gives labels/icons; the DB
// never constrains it). Variable, per-kind traits live in the Entity-Attribute-
// Value tables below, not in columns — so "Speed" or "Soil Fertility" are data,
// never schema. Everything is workspace-scoped for strict tenant isolation.
// ============================================================================

/// A generic object that may participate in or exist inside a simulation.
/// Products may rename this in their own UI (e.g. "Competitor"); the model stays generic.
model Entity {
  id             String    @id @default(cuid())
  workspaceId    String
  name           String
  shortName      String?
  description    String?
  category       String // open-ended kind key (country|robot|farm|…|custom slug); labelled in app layer
  imageUrl       String?
  primaryColor   String? // normalized hex, e.g. #22D3EE
  secondaryColor String?
  status         String    @default("ACTIVE") // EntityStatus (ACTIVE|ARCHIVED) — validated in app layer
  metadata       String? // serialized JSON for flexible secondary data (portable across SQLite/Postgres)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation("EntityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attributeValues EntityAttributeValue[]
  entityTags      EntityTag[]

  // Phase 2 — an Entity may be referenced by many Projects and Simulations.
  // These are reference links (join rows), never clones: deleting/archiving a
  // Project or Simulation must not touch the shared Entity (see join models).
  projectLinks    ProjectEntity[]
  simulationLinks SimulationEntity[]

  // Composite indexes keep list/search/filter/sort fast at scale and always
  // begin with workspaceId so every query is tenant-scoped by the leading column.
  @@index([workspaceId, status])
  @@index([workspaceId, category])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, name])
  @@index([createdById])
}

/// Definition of a reusable attribute (trait/stat) within a workspace — the "A" of EAV.
/// Custom attributes belong to the workspace that created them and are never shared across workspaces.
model AttributeDefinition {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String // display label, e.g. "Speed"
  key          String // normalized machine key, e.g. "speed"
  description  String?
  dataType     String // AttributeDataType (NUMBER|TEXT|BOOLEAN|SELECT) — validated in app layer
  unit         String? // optional display unit, e.g. "km/h"
  minimum      Float? // inclusive lower bound for NUMBER
  maximum      Float? // inclusive upper bound for NUMBER
  defaultValue String? // serialized default (per dataType)
  options      String? // serialized JSON array of allowed values for SELECT
  isBuiltIn    Boolean  @default(false) // originated from a built-in preset (Speed/Strength/…)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    EntityAttributeValue[]

  // Key is unique within a workspace — the same "speed" key can exist in other
  // workspaces, but never twice in one, keeping the workspace catalog clean.
  @@unique([workspaceId, key])
  @@index([workspaceId])
}

/// A single attribute value assigned to one entity — the "V" of EAV.
/// Typed at the app layer against its AttributeDefinition (e.g. NUMBER respects min/max).
model EntityAttributeValue {
  id                    String   @id @default(cuid())
  entityId              String
  attributeDefinitionId String
  value                 String // canonical serialized value (number as decimal string, boolean as "true"/"false", etc.)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  entity              Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  // An entity holds at most one value per attribute (no duplicate assignment).
  @@unique([entityId, attributeDefinitionId])
  @@index([attributeDefinitionId])
}

/// A normalized, workspace-scoped tag. Reused across entities via EntityTag.
model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String // display label as first entered
  slug        String // normalized key for de-duplication + filtering
  createdAt   DateTime @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityTags EntityTag[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

/// Join table linking entities to tags (many-to-many).
model EntityTag {
  entityId String
  tagId    String

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entityId, tagId])
  @@index([tagId])
}

// ============================================================================
// PROJECT SYSTEM (Phase 2 — workspace-owned organizational container)
//
// A Project groups existing Entities and Simulations (and, in future phases,
// Worlds/Tournaments/Assets/Results/Content) for a body of work. Projects
// REFERENCE Entities through the ProjectEntity join table — they never clone an
// Entity record. Everything is workspace-scoped; a Project may only ever link
// Entities from its own workspace (enforced in the service layer, never trusting
// client IDs). Archiving or deleting a Project must never delete a shared Entity.
// ============================================================================

/// A workspace-owned container that organizes Entities and Simulations.
model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  slug        String // normalized, human-readable key (not unique; routes use the cuid id)
  description String?
  imageUrl    String?
  coverUrl    String?
  status      String    @default("ACTIVE") // ProjectStatus (ACTIVE|ARCHIVED) — validated in app layer
  metadata    String? // serialized JSON for flexible secondary data (portable across SQLite/Postgres)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entityLinks ProjectEntity[]
  simulations Simulation[]

  // Every index leads with workspaceId so all list/search/sort queries stay tenant-scoped.
  @@index([workspaceId, status])
  @@index([workspaceId, name])
  @@index([workspaceId, updatedAt])
  @@index([createdById])
}

/// Reference link between a Project and an existing Entity (many-to-many).
/// This is a link row, NEVER a copy of the Entity. Cascade here only removes the
/// LINK when either side is deleted — it never deletes the shared Entity itself.
model ProjectEntity {
  projectId String
  entityId  String
  addedById String?
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("ProjectEntityAdder", fields: [addedById], references: [id], onDelete: SetNull)

  // Composite PK doubles as the uniqueness guard: an Entity links to a Project at most once.
  @@id([projectId, entityId])
  @@index([entityId])
  @@index([addedById])
}

// ============================================================================
// SIMULATION DEFINITION SYSTEM (Phase 2 — configuration/blueprint only)
//
// A Simulation is a SAVED CONFIGURATION (a blueprint), NOT an execution. There is
// deliberately no runtime here: no runs, ticks, RNG execution, rules, events, or
// results. Those belong to a future SimulationRun model in Phase 3. `mode` is an
// open-ended slug (battle|race|tournament|survival|…) resolved by an app-layer
// Mode Catalog — there is no table or column per mode. Participants are generic
// (SimulationEntity), never fighter1Id/car1Id, and reference live Entities.
// ============================================================================

/// A saved simulation configuration/blueprint owned by a Project. NOT executable in Phase 2.
model Simulation {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String
  name          String
  description   String?
  mode          String // open-ended mode slug (battle|race|tournament|survival|…); labelled in app layer
  status        String    @default("DRAFT") // SimulationStatus (DRAFT|READY|ARCHIVED) — validated in app layer
  seed          String? // metadata only (SV-XXXXXXXX); NOT executed in Phase 2
  configVersion Int       @default(1) // schema version of `configuration` (SimulationConfigV1)
  configuration String? // serialized JSON (SimulationConfigV1) — validated server-side, never trusted raw
  presentation  String? // serialized JSON (SimulationPresentationConfig) — stored separately from logic config
  metadata      String? // serialized JSON for flexible secondary data
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("SimulationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entityLinks SimulationEntity[]

  @@index([workspaceId, projectId])
  @@index([workspaceId, mode])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@index([projectId])
  @@index([createdById])
}

/// Generic participant link between a Simulation and an existing Entity.
/// Ordering/role/overrides are configuration only — they carry NO mechanics in
/// Phase 2. Cascade removes only the LINK, never the shared Entity. In Phase 3+,
/// participants will be snapshotted at run time; Phase 2 references the live Entity.
model SimulationEntity {
  simulationId String
  entityId     String
  position     Int      @default(0) // slot/order index within the simulation
  role         String? // optional participant role slug (app-layer meaning; no mechanics in Phase 2)
  overrides    String? // serialized JSON of per-participant config overrides/metadata
  addedAt      DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  entity     Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)

  // Composite PK doubles as the uniqueness guard: an Entity participates at most once.
  @@id([simulationId, entityId])
  @@index([entityId])
  @@index([simulationId, position])
}
