// Prisma schema for SIMVERSE — Phase 0 (Platform foundation).
//
// DATABASE NOTE:
//   Phase 0 targets SQLite for zero-setup local development. The schema is
//   intentionally written to be portable to PostgreSQL:
//     * No SQLite-only column types are used.
//     * Role / action values are stored as String and validated in the app
//       layer (src/lib/permissions) because SQLite has no native enums. On a
//       Postgres migration these can become native enums with a simple ALTER.
//     * AuditLog.metadata is a JSON string (portable) rather than a Json column.
//   To migrate: change datasource `provider` to "postgresql", point
//   DATABASE_URL at Postgres, then run `prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Connection URL lives in prisma.config.ts (Prisma 7 moved it out of the schema).
}

/// A platform user (account). Deliberately generic — no simulation/game stats live here.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  socialRequestsSent SocialFriendship[] @relation("SocialFriendSender")
  socialRequestsReceived SocialFriendship[] @relation("SocialFriendReceiver")
  socialBlocksCreated SocialBlock[] @relation("SocialBlockOwner")
  socialBlocksReceived SocialBlock[] @relation("SocialBlockTarget")
  socialMessagesSent SocialMessage[] @relation("SocialMessageSender")
  socialMessagesReceived SocialMessage[] @relation("SocialMessageRecipient")
  animationProjects AnimationProject[] @relation("AnimationOwner")
  socialGroupsCreated SocialGroup[] @relation("SocialGroupOwner")
  socialGroupMemberships SocialGroupMember[]
  socialGroupMessages SocialGroupMessage[]
  socialReactions SocialReaction[]
  socialNotifications SocialNotification[]
  callSignalsCreated SocialCallSignal[] @relation("CallSignalSender")
  callSignalsReceived SocialCallSignal[] @relation("CallSignalReceiver")

  economyLabs EconomyLab[] @relation("EconomyLabCreator")
  playerIdentity PlayerIdentity?
  virtualDocumentReviewGrants PlayerDocumentReviewer[] @relation("DocumentReviewerUser")
  virtualDocumentReviews PlayerDocumentApplication[] @relation("DocumentReviewActor")
  virtualTravelReviews PlayerTravelVisaApplication[] @relation("TravelVisaReviewActor")
  virtualCountryGovernanceGrants PlayerCountryGovernanceGrant[] @relation("VirtualGovernanceGrantUser")
  virtualCountryPoliciesProposed PlayerCitizenshipPolicy[] @relation("VirtualCitizenshipPolicyProposer")
  virtualCountryPoliciesActivated PlayerCitizenshipPolicy[] @relation("VirtualCitizenshipPolicyActivator")
  virtualTravelTreatiesProposed PlayerBilateralTravelAgreement[] @relation("VirtualTravelTreatyProposer")
  virtualTravelTreatiesOriginApproved PlayerBilateralTravelAgreement[] @relation("VirtualTravelTreatyOriginApprover")
  virtualTravelTreatiesDestinationApproved PlayerBilateralTravelAgreement[] @relation("VirtualTravelTreatyDestinationApprover")
  businessReviewGrant PlayerBusinessReviewer? @relation("BusinessReviewGrantUser")
  businessReviews PlayerVirtualBusiness[] @relation("BusinessReviewActor")

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  sessions        Session[]
  auditLogs       AuditLog[]        @relation("AuditActor")
  createdEntities Entity[]          @relation("EntityCreator")

  // Phase 2 — Projects & Simulation definitions authored by this user.
  createdProjects      Project[]       @relation("ProjectCreator")
  addedProjectEntities ProjectEntity[] @relation("ProjectEntityAdder")
  createdSimulations   Simulation[]    @relation("SimulationCreator")
  createdRuns          SimulationRun[] @relation("RunCreator")
  createdAssets        Asset[]         @relation("AssetCreator")
  createdAssetVersions AssetVersion[]  @relation("AssetVersionCreator")
  createdWorlds        World[]         @relation("WorldCreator")
  createdWorldVersions WorldVersion[]  @relation("WorldVersionCreator")
  createdExperienceProfiles ExperienceProfile[]        @relation("ExperienceProfileCreator")
  createdExperienceVersions ExperienceProfileVersion[] @relation("ExperienceProfileVersionCreator")
  createdTournaments        Tournament[]                @relation("TournamentCreator")
  createdMediaArtifacts     MediaArtifact[]             @relation("MediaArtifactCreator")
  createdMediaVersions      MediaArtifactVersion[]      @relation("MediaArtifactVersionCreator")
  createdMediaShares        MediaShare[]                @relation("MediaShareCreator")

  // SIMVERSE Earth global stewardship is deliberately separate from
  // workspace roles. A workspace administrator is not automatically allowed
  // to activate or retire global virtual-land inventory.
  earthStewardGrant         EarthSteward?                        @relation("EarthStewardUser")
  earthStewardGrantsIssued  EarthSteward[]                       @relation("EarthStewardGrantor")
  createdEarthZones         EarthDevelopmentZone[]               @relation("EarthZoneCreator")
  createdEarthZoneVersions  EarthDevelopmentZoneVersion[]        @relation("EarthZoneVersionCreator")
  reviewedEarthZoneVersions EarthDevelopmentZoneVersion[]        @relation("EarthZoneVersionReviewer")
  earthZoneLifecycleEvents  EarthDevelopmentZoneLifecycleEvent[] @relation("EarthZoneLifecycleActor")
}

// ============================================================================
// SIMVERSE PLAYER IDENTITY — Phase 1
// This virtual identity is not a real government document, nationality,
// citizenship, passport, residency or title to land. Profile privacy is
// private by default. Workspace privileges stay entirely separate.
// ============================================================================

model PlayerIdentity {
  id             String   @id @default(cuid())
  userId         String   @unique
  simverseId     String   @unique
  username       String?  @unique
  creatorName    String?
  biography      String   @default("")
  bannerUrl      String?
  profileVisibility String @default("PRIVATE") // PRIVATE | PUBLIC; app validated
  experienceMode String   @default("BOTH")      // PLAYER | CREATOR | BOTH
  homeCountryId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeCountry    EarthGeoPlace?        @relation("PlayerHomeCountry", fields: [homeCountryId], references: [id], onDelete: SetNull)
  citizenships   PlayerCitizenship[]
  documentApplications PlayerDocumentApplication[]
  virtualDocuments PlayerVirtualDocument[]
  travelVisaApplications PlayerTravelVisaApplication[]
  careerProfile PlayerCareerProfile?
  virtualWallet PlayerVirtualWallet?
  virtualBusinesses PlayerVirtualBusiness[]
  orientationCertificate PlayerOrientationCertificate?
  workApplications PlayerWorkApplication[]

  @@index([profileVisibility, username])
  @@index([homeCountryId])
}

// A citizenship ledger foundation, not a passport issuer.
// Only future separately authorized workflows may award ACTIVE citizenship.
// Phase 1 profile edits never insert, grant or approve citizenship records.
model PlayerCitizenship {
  id              String   @id @default(cuid())
  playerIdentityId String
  countryPlaceId  String
  status          String   @default("PENDING_REVIEW")
  category        String   @default("STANDARD")
  sourceApplicationId String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  reviewedAt      DateTime?
  reviewNote      String?

  identity  PlayerIdentity @relation(fields: [playerIdentityId], references: [id], onDelete: Cascade)
  country   EarthGeoPlace  @relation("PlayerCitizenshipCountry", fields: [countryPlaceId], references: [id], onDelete: Restrict)

  @@unique([playerIdentityId, countryPlaceId])
  @@index([countryPlaceId, status])
}

// Player-only applications and approvals. No governmental/real-world authority.
// The pilot permits one application per type and virtual country; denials
// require future policy workflow before resubmission.
model PlayerDocumentApplication {
  id               String    @id @default(cuid())
  identityId       String
  countryPlaceId   String
  kind             String    // CITIZENSHIP | NATIONAL_PASSPORT | INTERNATIONAL_PASSPORT | RESIDENCY
  status           String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | DENIED
  statement        String    @default("")
  eligibilityJson  String    @default("{}")
  reviewNote       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  identity    PlayerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  country     EarthGeoPlace  @relation("DocumentApplicationCountry", fields: [countryPlaceId], references: [id], onDelete: Restrict)
  reviewedBy User?          @relation("DocumentReviewActor", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  document   PlayerVirtualDocument?

  @@unique([identityId, countryPlaceId, kind])
  @@index([countryPlaceId, status, createdAt])
  @@index([identityId, createdAt])
}

// Fictional in-world record, not a replica or real passport.
// All issuances require a separate authorized country reviewer and a
// validated application. A credential has no real-world travel significance.
model PlayerVirtualDocument {
  id            String   @id @default(cuid())
  applicationId String   @unique
  identityId    String
  kind          String
  serial        String   @unique
  status        String   @default("ISSUED") // ISSUED | REVOKED
  issuedAt      DateTime @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  application PlayerDocumentApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  identity    PlayerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, kind, status])
  @@index([expiresAt])
}

// Country-scoped review access is explicitly provisioned outside public APIs;
// Earth stewardship, workspace owner/admin and player profile roles NEVER
// convey passport/citizenship review authority.
model PlayerDocumentReviewer {
  id             String   @id @default(cuid())
  userId         String
  countryPlaceId String
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())

  user    User          @relation("DocumentReviewerUser", fields: [userId], references: [id], onDelete: Cascade)
  country EarthGeoPlace @relation("DocumentReviewerCountry", fields: [countryPlaceId], references: [id], onDelete: Restrict)

  @@unique([userId, countryPlaceId])
  @@index([countryPlaceId, isActive])
}

// SIMVERSE Phase 3 fictional world travel rules. An unconfigured/disabled
// route is CLOSED; no implicit treaty or visa-free travel between countries.
// Rules are operator-provisioned only; no player-facing policy mutation APIs.
model PlayerTravelRoutePolicy {
  id                   String   @id @default(cuid())
  originCountryId      String
  destinationCountryId String
  isActive             Boolean  @default(false)
  mode                 String   @default("CLOSED") // CLOSED | VISA_REQUIRED | VISA_WAIVER
  passportKind         String   @default("INTERNATIONAL_PASSPORT")
  description          String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  originCountry EarthGeoPlace @relation("TravelRuleOriginCountry", fields: [originCountryId], references: [id], onDelete: Restrict)
  destinationCountry EarthGeoPlace @relation("TravelRuleDestinationCountry", fields: [destinationCountryId], references: [id], onDelete: Restrict)
  visaApplications PlayerTravelVisaApplication[]

  @@unique([originCountryId, destinationCountryId])
  @@index([destinationCountryId, isActive])
}

// A single in-world entry-visa application per player/route in the pilot.
// It is NOT government immigration paperwork, nor a border-control action.
model PlayerTravelVisaApplication {
  id                    String    @id @default(cuid())
  identityId            String
  originCountryId       String
  destinationCountryId  String
  policyId              String
  status                String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | DENIED
  purpose               String    @default("")
  submittedAt           DateTime  @default(now())
  reviewedAt            DateTime?
  reviewedByUserId      String?
  reviewNote            String?
  issuedAt              DateTime?
  expiresAt             DateTime?
  serial                String?   @unique

  identity PlayerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  originCountry EarthGeoPlace @relation("TravelVisaOriginCountry", fields: [originCountryId], references: [id], onDelete: Restrict)
  destinationCountry EarthGeoPlace @relation("TravelVisaDestinationCountry", fields: [destinationCountryId], references: [id], onDelete: Restrict)
  policy PlayerTravelRoutePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("TravelVisaReviewActor", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([identityId, originCountryId, destinationCountryId])
  @@index([destinationCountryId, status, submittedAt])
  @@index([identityId, submittedAt])
}

// Phase 4 governance grants are never implied by workspace ownership or
// passport reviewer status. Created offline by an independently authorized
// SIMVERSE operator; all grants start inactive and cannot approve by default.
model PlayerCountryGovernanceGrant {
  id             String @id @default(cuid())
  userId         String
  countryPlaceId String
  isActive       Boolean @default(false)
  canActivate    Boolean @default(false)
  createdAt      DateTime @default(now())

  user    User @relation("VirtualGovernanceGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  country EarthGeoPlace @relation("VirtualGovernanceGrantCountry", fields: [countryPlaceId], references: [id], onDelete: Restrict)

  @@unique([userId, countryPlaceId])
  @@index([countryPlaceId, isActive])
}

// Policy activated by a different explicitly authorized administrator
// than the user who proposed it. Historical versions remain immutable.
model PlayerCitizenshipPolicy {
  id                    String @id @default(cuid())
  countryPlaceId        String
  revision              Int
  status                String @default("DRAFT") // DRAFT | ACTIVE | SUPERSEDED
  allowsDualCitizenship Boolean @default(false)
  minResidenceDays      Int     @default(180)
  proposedByUserId      String
  activatedByUserId     String?
  proposedAt            DateTime @default(now())
  activatedAt           DateTime?

  country EarthGeoPlace @relation("VirtualCitizenshipPolicyCountry", fields: [countryPlaceId], references: [id], onDelete: Restrict)
  proposedBy User @relation("VirtualCitizenshipPolicyProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  activatedBy User? @relation("VirtualCitizenshipPolicyActivator", fields: [activatedByUserId], references: [id], onDelete: SetNull)

  @@unique([countryPlaceId, revision])
  @@index([countryPlaceId, status])
}

// Bilateral visa waivers require two country-scoped approvals from different
// people. No regional agreement can be inferred from real-world geography.
model PlayerBilateralTravelAgreement {
  id                        String @id @default(cuid())
  originCountryId           String
  destinationCountryId      String
  status                    String @default("DRAFT") // DRAFT | ACTIVE | SUSPENDED
  proposedByUserId          String
  originApprovedByUserId    String?
  destinationApprovedByUserId String?
  originApprovedAt          DateTime?
  destinationApprovedAt     DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  originCountry EarthGeoPlace @relation("VirtualTravelTreatyOriginCountry", fields: [originCountryId], references: [id], onDelete: Restrict)
  destinationCountry EarthGeoPlace @relation("VirtualTravelTreatyDestinationCountry", fields: [destinationCountryId], references: [id], onDelete: Restrict)
  proposedBy User @relation("VirtualTravelTreatyProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  originApprovedBy User? @relation("VirtualTravelTreatyOriginApprover", fields: [originApprovedByUserId], references: [id], onDelete: SetNull)
  destinationApprovedBy User? @relation("VirtualTravelTreatyDestinationApprover", fields: [destinationApprovedByUserId], references: [id], onDelete: SetNull)

  @@unique([originCountryId, destinationCountryId])
  @@index([status, createdAt])
}

// --------------------------------------------------------------------------
// PLAYER ECONOMY Phase 5 (pilot). All SVC balances are nonredeemable
// fictional game points: never money, crypto, payments or cash equivalents.
// --------------------------------------------------------------------------

model PlayerCareerProfile {
  id                 String   @id @default(cuid())
  identityId         String   @unique
  professionCode     String   // Strict server-side closed profession catalog
  selectedAt         DateTime @default(now())
  onboardingVersion  Int      @default(1)

  identity PlayerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([professionCode])
}

model PlayerVirtualWallet {
  id          String   @id @default(cuid())
  identityId  String   @unique
  currency    String   @default("SVC")
  balance     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  identity PlayerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  entries PlayerWalletEntry[]
}

// Positive single-source, immutable mint history for introductory credits.
// Wallet snapshot and entry must be created inside the same DB transaction.
// No exposed spending, transfer, payment or mint endpoint in this phase.
model PlayerWalletEntry {
  id         String @id @default(cuid())
  walletId   String
  eventKey   String @unique // one-time onboarding idempotency key
  kind       String // STARTER_GRANT only in Phase 5
  amount     Int
  balanceAfter Int
  createdAt  DateTime @default(now())

  wallet PlayerVirtualWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
}

// A draft in-world company identity is not an operating license, actual
// business registration or title. A later governed flow will approve it.
model PlayerVirtualBusiness {
  id             String   @id @default(cuid())
  identityId     String
  name           String
  nameKey        String   @unique
  sector         String
  description    String   @default("")
  status         String   @default("DRAFT") // DRAFT; no player grant endpoint
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reviewedByUserId String?
  reviewedAt DateTime?
  reviewNote String?
  identity PlayerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("BusinessReviewActor", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  jobs PlayerVirtualJob[]

  @@index([identityId, createdAt])
}

// Phase 6: introductory in-world orientation. Not verified real-world education,
// qualification, employment or medical/professional licensure.
model PlayerOrientationCertificate {
  id String @id @default(cuid())
  identityId String @unique
  professionCode String
  assessmentVersion Int @default(1)
  score Int
  earnedAt DateTime @default(now())
  identity PlayerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
}

// A SIMVERSE operator must provision an independent reviewer out-of-band.
// No business owner or workspace role implicitly receives this grant.
model PlayerBusinessReviewer {
  id String @id @default(cuid())
  userId String @unique
  isActive Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation("BusinessReviewGrantUser", fields: [userId], references: [id], onDelete: Cascade)
}

// Employment matching is fictional and never generates payroll/money.
// Hiring requires a previously approved virtual business.
model PlayerVirtualJob {
  id String @id @default(cuid())
  businessId String
  title String
  description String
  professionCode String
  status String @default("OPEN") // OPEN | CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business PlayerVirtualBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  applications PlayerWorkApplication[]
  @@index([status, createdAt])
  @@index([businessId, createdAt])
}

model PlayerWorkApplication {
  id String @id @default(cuid())
  jobId String
  applicantIdentityId String
  statement String
  status String @default("SUBMITTED") // SUBMITTED | OFFERED | REJECTED | ACCEPTED | DECLINED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job PlayerVirtualJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  applicant PlayerIdentity @relation(fields: [applicantIdentityId], references: [id], onDelete: Cascade)
  employment PlayerVirtualEmployment?
  @@unique([jobId, applicantIdentityId])
  @@index([applicantIdentityId, createdAt])
}

model PlayerVirtualEmployment {
  id String @id @default(cuid())
  applicationId String @unique
  startedAt DateTime @default(now())
  status String @default("ACTIVE")
  application PlayerWorkApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
}

/// A workspace: the primary tenant boundary. Users may belong to many workspaces.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  auditLogs AuditLog[]

  entities             Entity[]
  attributeDefinitions AttributeDefinition[]
  tags                 Tag[]
  projects             Project[]
  simulations          Simulation[]
  simulationRuns       SimulationRun[]
  assets               Asset[]
  worlds               World[]
  experienceProfiles   ExperienceProfile[]
  tournaments          Tournament[]
  mediaArtifacts       MediaArtifact[]
  mediaShares          MediaShare[]
  economyLabs          EconomyLab[]
  animationProjects AnimationProject[]
}

/// Membership linking a user to a workspace with a role. Role governs permissions.
model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String // WorkspaceRole (OWNER|ADMIN|CREATOR|OPERATOR|EDITOR|ANALYST|VIEWER) — validated in app layer
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Server-side session. The cookie holds an opaque token; only its HMAC hash is stored.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only audit trail of significant platform actions.
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorUserId String?
  action      String // e.g. user.registered, user.logged_in, workspace.created, workspace.updated
  entityType  String?
  entityId    String?
  metadata    String? // serialized JSON (portable across SQLite/Postgres)
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([actorUserId])
  @@index([createdAt])
}

// ============================================================================
// ENTITY SYSTEM (Phase 1 — the generic, extensible object model)
//
// One architecture represents every kind of object a simulation might contain —
// Country, Robot, Animal, Vehicle, City, Farm, Business, Team, Person, Machine,
// Custom, … — WITHOUT a table per kind. `category` is a plain String key so the
// set of kinds is open-ended (an app-layer catalog gives labels/icons; the DB
// never constrains it). Variable, per-kind traits live in the Entity-Attribute-
// Value tables below, not in columns — so "Speed" or "Soil Fertility" are data,
// never schema. Everything is workspace-scoped for strict tenant isolation.
// ============================================================================

// ============================================================================
// SIMVERSE EARTH - GLOBAL GEOGRAPHY CATALOG (Earth Phase 2)
//
// Geography is global sourced reference data, not workspace-authored World
// Blueprint content. Geometry remains WGS84 GeoJSON in the SQLite baseline.
// The isolated PostGIS proof schema provides native geometry + GiST indexes for
// the later reversible database migration.
// ============================================================================

model EarthGeoDataset {
  id          String   @id @default(cuid())
  providerKey String
  releaseType String
  name        String
  sourceUrl   String
  licenseName String
  licenseUrl  String
  attribution String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions EarthGeoDatasetVersion[]

  @@unique([providerKey, releaseType])
  @@index([providerKey])
}

model EarthGeoDatasetVersion {
  id               String    @id @default(cuid())
  datasetId        String
  versionKey       String
  sourceRevision   String
  status           String    @default("STAGED")
  manifestChecksum String
  sourceMetadata   String
  importedAt       DateTime?
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())

  dataset   EarthGeoDataset         @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  imports   EarthGeoImport[]
  revisions EarthGeoPlaceRevision[]

  @@unique([datasetId, versionKey])
  @@index([datasetId, status])
  @@index([sourceRevision])
}

model EarthGeoImport {
  id               String    @id @default(cuid())
  datasetVersionId String
  importKey        String    @unique
  status           String
  sourceManifest   String
  sourceChecksum   String
  recordsRead      Int       @default(0)
  recordsCreated   Int       @default(0)
  recordsUpdated   Int       @default(0)
  recordsSkipped   Int       @default(0)
  errorSummary     String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  datasetVersion EarthGeoDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)

  @@index([datasetVersionId, startedAt])
  @@index([status, startedAt])
}

model EarthGeoPlace {
  id              String   @id @default(cuid())
  publicId        String   @unique
  canonicalKey    String   @unique
  kind            String
  name            String
  normalizedName  String
  isoAlpha2       String?
  isoAlpha3       String?
  adminLevel      Int?
  parentId        String?
  sourceProvider  String
  sourceFeatureId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent    EarthGeoPlace?          @relation("EarthGeoHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  EarthGeoPlace[]         @relation("EarthGeoHierarchy")
  revisions EarthGeoPlaceRevision[]
  developmentZones EarthDevelopmentZone[]
  homeCountryIdentities PlayerIdentity[] @relation("PlayerHomeCountry")
  virtualCitizenships  PlayerCitizenship[] @relation("PlayerCitizenshipCountry")
  virtualDocumentApplications PlayerDocumentApplication[] @relation("DocumentApplicationCountry")
  virtualDocumentReviewGrants PlayerDocumentReviewer[] @relation("DocumentReviewerCountry")
  virtualOutboundTravelRules PlayerTravelRoutePolicy[] @relation("TravelRuleOriginCountry")
  virtualInboundTravelRules PlayerTravelRoutePolicy[] @relation("TravelRuleDestinationCountry")
  virtualOutboundVisas PlayerTravelVisaApplication[] @relation("TravelVisaOriginCountry")
  virtualInboundVisas PlayerTravelVisaApplication[] @relation("TravelVisaDestinationCountry")
  virtualCountryGovernanceGrants PlayerCountryGovernanceGrant[] @relation("VirtualGovernanceGrantCountry")
  virtualCitizenshipPolicies PlayerCitizenshipPolicy[] @relation("VirtualCitizenshipPolicyCountry")
  virtualTravelTreatiesOrigin PlayerBilateralTravelAgreement[] @relation("VirtualTravelTreatyOriginCountry")
  virtualTravelTreatiesDestination PlayerBilateralTravelAgreement[] @relation("VirtualTravelTreatyDestinationCountry")

  @@index([parentId, kind, name])
  @@index([kind, normalizedName])
  @@index([isoAlpha3, adminLevel])
  @@index([sourceProvider, sourceFeatureId])
}

model EarthGeoPlaceRevision {
  id                        String   @id @default(cuid())
  placeId                   String
  datasetVersionId          String
  revision                  Int
  sourceBoundaryId          String?
  sourceName                String
  geometryType              String
  geometryGeoJson           String?
  bboxWest                  Float?
  bboxSouth                 Float?
  bboxEast                  Float?
  bboxNorth                 Float?
  labelLongitude            Float?
  labelLatitude             Float?
  coordinateReferenceSystem String   @default("EPSG:4326")
  boundaryQuality           String
  verificationStatus        String
  sourceProperties          String   @default("{}")
  contentHash               String
  isCurrent                 Boolean  @default(true)
  createdAt                 DateTime @default(now())

  place          EarthGeoPlace          @relation(fields: [placeId], references: [id], onDelete: Restrict)
  datasetVersion EarthGeoDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  zoneVersions   EarthDevelopmentZoneVersion[]

  @@unique([placeId, revision])
  @@unique([placeId, datasetVersionId])
  @@index([placeId, isCurrent])
  @@index([datasetVersionId])
  @@index([boundaryQuality, verificationStatus])
  @@index([bboxWest, bboxEast])
  @@index([bboxSouth, bboxNorth])
}

// ============================================================================
// SIMVERSE EARTH - DEVELOPMENT ZONES (Earth Phase 4)
//
// Development zones are reviewed SIMVERSE virtual-development policy areas.
// They are not cadastral boundaries and are not inferred from locality points.
// Complete immutable definitions live in version rows; only lifecycle state and
// the stable zone's active-version projection may change. Unclaimed parcels are
// derived on demand and are intentionally not stored in this schema.
// ============================================================================

model EarthSteward {
  id              String    @id @default(cuid())
  userId          String    @unique
  role            String    @default("STEWARD")
  canActivate     Boolean   @default(false)
  isActive        Boolean   @default(true)
  grantedByUserId String?
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?

  user      User  @relation("EarthStewardUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("EarthStewardGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@index([isActive, canActivate])
}

model EarthDevelopmentZone {
  id              String   @id @default(cuid())
  publicId        String   @unique
  canonicalKey    String   @unique
  name            String
  normalizedName  String
  placeId         String
  status          String   @default("DRAFT")
  activeVersionId String?  @unique
  isDemonstration Boolean  @default(false)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  place         EarthGeoPlace                        @relation(fields: [placeId], references: [id], onDelete: Restrict)
  activeVersion EarthDevelopmentZoneVersion?         @relation("EarthActiveZoneVersion", fields: [activeVersionId], references: [id], onDelete: Restrict)
  versions      EarthDevelopmentZoneVersion[]        @relation("EarthZoneVersions")
  lifecycle     EarthDevelopmentZoneLifecycleEvent[]
  createdBy     User                                 @relation("EarthZoneCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([placeId, status, name])
  @@index([status, isDemonstration])
}

model EarthDevelopmentZoneVersion {
  id                    String    @id @default(cuid())
  publicId              String    @unique
  zoneId                String
  version               Int
  status                String    @default("DRAFT")
  sourcePlaceRevisionId String
  geometryGeoJson       String
  exclusionsJson        String    @default("[]")
  bboxWest              Float
  bboxSouth             Float
  bboxEast              Float
  bboxNorth             Float
  projectionCode        String
  projectionDefinition  String
  projectionSrid        Int
  gridOriginLongitude   Float
  gridOriginLatitude    Float
  gridOriginEasting     Float
  gridOriginNorthing    Float
  gridBearingDegrees    Float     @default(0)
  cellWidthMeters       Float     @default(25)
  cellHeightMeters      Float     @default(25)
  algorithmVersion      String    @default("earth-parcel-grid-v1")
  edgePolicy            String    @default("FULL_CELL")
  restrictionsJson      String    @default("{}")
  provenanceJson        String
  contentHash           String
  reviewNote            String?
  createdByUserId       String
  reviewedByUserId      String?
  submittedAt           DateTime?
  activatedAt           DateTime?
  retiredAt             DateTime?
  createdAt             DateTime  @default(now())

  zone                EarthDevelopmentZone                 @relation("EarthZoneVersions", fields: [zoneId], references: [id], onDelete: Restrict)
  activeForZone       EarthDevelopmentZone?                @relation("EarthActiveZoneVersion")
  sourcePlaceRevision EarthGeoPlaceRevision                @relation(fields: [sourcePlaceRevisionId], references: [id], onDelete: Restrict)
  createdBy           User                                 @relation("EarthZoneVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy          User?                                @relation("EarthZoneVersionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  lifecycle           EarthDevelopmentZoneLifecycleEvent[]

  @@unique([zoneId, version])
  @@unique([zoneId, contentHash])
  @@index([zoneId, status, version])
  @@index([sourcePlaceRevisionId])
  @@index([bboxWest, bboxEast])
  @@index([bboxSouth, bboxNorth])
}

model EarthDevelopmentZoneLifecycleEvent {
  id            String   @id @default(cuid())
  zoneId        String
  zoneVersionId String
  action        String
  actorUserId   String
  fromStatus    String?
  toStatus      String
  metadata      String?
  createdAt     DateTime @default(now())

  zone        EarthDevelopmentZone        @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  zoneVersion EarthDevelopmentZoneVersion @relation(fields: [zoneVersionId], references: [id], onDelete: Restrict)
  actor       User                        @relation("EarthZoneLifecycleActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([zoneId, createdAt])
  @@index([zoneVersionId, createdAt])
}

/// A generic object that may participate in or exist inside a simulation.
/// Products may rename this in their own UI (e.g. "Competitor"); the model stays generic.
model Entity {
  id             String    @id @default(cuid())
  workspaceId    String
  name           String
  shortName      String?
  description    String?
  category       String // open-ended kind key (country|robot|farm|…|custom slug); labelled in app layer
  imageUrl       String?
  primaryColor   String? // normalized hex, e.g. #22D3EE
  secondaryColor String?
  status         String    @default("ACTIVE") // EntityStatus (ACTIVE|ARCHIVED) — validated in app layer
  metadata       String? // serialized JSON for flexible secondary data (portable across SQLite/Postgres)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation("EntityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attributeValues EntityAttributeValue[]
  entityTags      EntityTag[]
  visualProfile  EntityVisualProfile?

  // Phase 2 — an Entity may be referenced by many Projects and Simulations.
  // These are reference links (join rows), never clones: deleting/archiving a
  // Project or Simulation must not touch the shared Entity (see join models).
  projectLinks    ProjectEntity[]
  simulationLinks SimulationEntity[]
  assetLinks      AssetEntity[]
  worldLinks      WorldEntity[]
  experienceLinks ExperienceEntity[]
  tournamentParticipants TournamentParticipant[]

  // Composite indexes keep list/search/filter/sort fast at scale and always
  // begin with workspaceId so every query is tenant-scoped by the leading column.
  @@index([workspaceId, status])
  @@index([workspaceId, category])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, name])
  @@index([createdById])
}

/// Creator-managed visual identity for an Entity. Simulation attributes and
/// mechanics stay on Entity/EAV; this record is presentation configuration.
/// String vocabularies and JSON animation mappings are validated by the app so
/// the SQLite schema remains portable to PostgreSQL.
model EntityVisualProfile {
  id               String   @id @default(cuid())
  entityId         String   @unique
  sourceType       String   @default("PROCEDURAL")
  portraitUrl      String?
  modelUrl         String?
  archetype        String   @default("CUSTOM")
  scale            Float    @default(1)
  rotationX        Float    @default(0)
  rotationY        Float    @default(0)
  rotationZ        Float    @default(0)
  offsetX          Float    @default(0)
  offsetY          Float    @default(0)
  offsetZ          Float    @default(0)
  animationProfile String?  // bounded JSON map: SIMVERSE state -> imported clip name
  enabled          Boolean  @default(true)
  revision         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([sourceType])
  @@index([archetype])
}

/// Definition of a reusable attribute (trait/stat) within a workspace — the "A" of EAV.
/// Custom attributes belong to the workspace that created them and are never shared across workspaces.
model AttributeDefinition {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String // display label, e.g. "Speed"
  key          String // normalized machine key, e.g. "speed"
  description  String?
  dataType     String // AttributeDataType (NUMBER|TEXT|BOOLEAN|SELECT) — validated in app layer
  unit         String? // optional display unit, e.g. "km/h"
  minimum      Float? // inclusive lower bound for NUMBER
  maximum      Float? // inclusive upper bound for NUMBER
  defaultValue String? // serialized default (per dataType)
  options      String? // serialized JSON array of allowed values for SELECT
  isBuiltIn    Boolean  @default(false) // originated from a built-in preset (Speed/Strength/…)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    EntityAttributeValue[]

  // Key is unique within a workspace — the same "speed" key can exist in other
  // workspaces, but never twice in one, keeping the workspace catalog clean.
  @@unique([workspaceId, key])
  @@index([workspaceId])
}

/// A single attribute value assigned to one entity — the "V" of EAV.
/// Typed at the app layer against its AttributeDefinition (e.g. NUMBER respects min/max).
model EntityAttributeValue {
  id                    String   @id @default(cuid())
  entityId              String
  attributeDefinitionId String
  value                 String // canonical serialized value (number as decimal string, boolean as "true"/"false", etc.)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  entity              Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  // An entity holds at most one value per attribute (no duplicate assignment).
  @@unique([entityId, attributeDefinitionId])
  @@index([attributeDefinitionId])
}

/// A normalized, workspace-scoped tag. Reused across entities via EntityTag.
model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String // display label as first entered
  slug        String // normalized key for de-duplication + filtering
  createdAt   DateTime @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityTags EntityTag[]
  assetTags  AssetTag[]
  worldTags  WorldTag[]
  experienceProfileTags ExperienceProfileTag[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

/// Join table linking entities to tags (many-to-many).
model EntityTag {
  entityId String
  tagId    String

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entityId, tagId])
  @@index([tagId])
}

// ============================================================================
// ASSET LIBRARY (Web Phase 1 — metadata, versions and safe external references)
//
// Asset binaries stay in object storage/CDNs and are never stored in this
// database. Asset is the stable workspace identity and searchable projection;
// every mutation appends an immutable AssetVersion snapshot so history remains
// inspectable and downstream consumers can pin a precise version.
// ============================================================================

model Asset {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  description        String?
  type               String
  status             String    @default("DRAFT")
  currentVersion     Int       @default(1)
  archivedFromStatus String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("AssetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions     AssetVersion[]
  assetTags    AssetTag[]
  entityLinks  AssetEntity[]
  parentLinks  AssetRelationship[] @relation("AssetRelationshipDerived")
  derivedLinks AssetRelationship[] @relation("AssetRelationshipParent")
  worldLinks   WorldAsset[]
  experienceLinks ExperienceAsset[]

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, name])
  @@index([createdById])
}

model AssetVersion {
  id                     String   @id @default(cuid())
  assetId                String
  version                Int
  name                   String
  description            String?
  type                   String
  status                 String
  tags                   String
  provenance             String
  licenseInfo            String?
  authorInfo             String?
  externalReference      String?
  thumbnailReference     String?
  technicalMetadata      String?
  modelSpecification     String?
  rigSpecification       String?
  animationSpecification String?
  productionChecklist    String
  entityAssociations     String
  derivedFromAssetIds    String
  changeNote             String?
  createdById            String?
  createdAt              DateTime @default(now())

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AssetVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([assetId, version])
  @@index([assetId, createdAt])
  @@index([createdById])
}

/// Current searchable tag assignment. Each AssetVersion separately snapshots
/// tag names, so changing current tags never rewrites historical versions.
model AssetTag {
  assetId String
  tagId   String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([tagId])
}

/// Workspace-validated Entity association. version pins the association to an
/// immutable AssetVersion while Asset remains the stable library identity.
model AssetEntity {
  assetId   String
  entityId  String
  version   Int
  purpose   String   @default("PRIMARY")
  createdAt DateTime @default(now())

  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([assetId, entityId, purpose])
  @@index([entityId])
}

/// Directed lineage between stable Asset identities. Version-specific source
/// provenance remains frozen inside AssetVersion metadata.
model AssetRelationship {
  parentAssetId  String
  derivedAssetId String
  relationship   String   @default("DERIVED_FROM")
  createdAt      DateTime @default(now())

  parentAsset  Asset @relation("AssetRelationshipParent", fields: [parentAssetId], references: [id], onDelete: Cascade)
  derivedAsset Asset @relation("AssetRelationshipDerived", fields: [derivedAssetId], references: [id], onDelete: Cascade)

  @@id([parentAssetId, derivedAssetId, relationship])
  @@index([derivedAssetId])
}

// ============================================================================
// WORLD BLUEPRINT CREATOR (Web Phase 2 — engine-neutral environment metadata)
//
// World is the stable, searchable workspace identity. Every edit appends an
// immutable WorldVersion containing the complete validated blueprint. Current
// tag, Asset and Entity joins are projections for discovery and authorization;
// the version snapshot remains the historical authority.
// ============================================================================

model World {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  slug               String
  description        String?
  category           String
  status             String    @default("DRAFT")
  currentVersion     Int       @default(1)
  archivedFromStatus String?
  biome              String
  thumbnailReference String?
  visibility         String    @default("WORKSPACE")
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("WorldCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions    WorldVersion[]
  worldTags   WorldTag[]
  assetLinks  WorldAsset[]
  entityLinks WorldEntity[]
  simulations Simulation[]
  experienceLinks ExperienceWorld[]
  tournaments Tournament[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, biome])
  @@index([workspaceId, category])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, name])
  @@index([createdById])
}

model WorldVersion {
  id                 String   @id @default(cuid())
  worldId            String
  version            Int
  blueprintVersion   Int      @default(1)
  name               String
  description        String?
  category           String
  status             String
  tags               String
  biome              String
  thumbnailReference String?
  visibility         String
  blueprint          String
  assetAssociations  String
  entityAssociations String
  contentHash        String
  changeNote         String?
  createdById        String?
  createdAt          DateTime @default(now())

  world     World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  createdBy User? @relation("WorldVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([worldId, version])
  @@index([worldId, createdAt])
  @@index([createdById])
}

model WorldTag {
  worldId String
  tagId   String

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([worldId, tagId])
  @@index([tagId])
}

/// Current World-to-Asset projection. Each placement pins an immutable Asset
/// version and stores only validated engine-neutral placement/configuration.
model WorldAsset {
  worldId       String
  identifier    String
  assetId       String
  assetVersion  Int
  role          String
  placement     String?
  configuration String?
  createdAt     DateTime @default(now())

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([worldId, identifier])
  @@index([assetId])
  @@index([worldId, role])
}

model WorldEntity {
  worldId       String
  entityId      String
  relationship  String
  configuration String?
  createdAt     DateTime @default(now())

  world  World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@id([worldId, entityId, relationship])
  @@index([entityId])
}

// ============================================================================
// EXPERIENCE PROFILES (Web Phase 3 — engine-neutral presentation direction)
//
// Core and Modules remain authoritative. Experience Profiles only map saved
// events to animation, camera, VFX, audio, HUD and pacing semantics. Every
// change appends a complete immutable version; current join rows are searchable
// and workspace-validating projections rather than historical authority.
// ============================================================================

model ExperienceProfile {
  id                    String    @id @default(cuid())
  workspaceId           String
  name                  String
  slug                  String
  description           String?
  status                String    @default("DRAFT")
  currentVersion        Int       @default(1)
  archivedFromStatus    String?
  preset                String    @default("CUSTOM")
  moduleCompatibility   String
  modeCompatibility     String
  thumbnailReference    String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt            DateTime?

  workspace     Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?                      @relation("ExperienceProfileCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions      ExperienceProfileVersion[]
  profileTags   ExperienceProfileTag[]
  eventBindings ExperienceEventBinding[]
  assetLinks    ExperienceAsset[]
  entityLinks   ExperienceEntity[]
  worldLinks    ExperienceWorld[]
  simulations   Simulation[]
  tournaments   Tournament[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, preset])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, name])
  @@index([createdById])
}

model ExperienceProfileVersion {
  id                    String   @id @default(cuid())
  experienceProfileId   String
  version               Int
  schemaVersion         Int      @default(1)
  name                  String
  description           String?
  status                String
  tags                  String
  preset                String
  moduleCompatibility   String
  modeCompatibility     String
  thumbnailReference    String?
  definition            String
  contentHash           String
  changeNote            String?
  createdById           String?
  createdAt             DateTime @default(now())

  experienceProfile ExperienceProfile @relation(fields: [experienceProfileId], references: [id], onDelete: Cascade)
  createdBy         User?             @relation("ExperienceProfileVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([experienceProfileId, version])
  @@index([experienceProfileId, createdAt])
  @@index([createdById])
}

model ExperienceProfileTag {
  experienceProfileId String
  tagId                String

  experienceProfile ExperienceProfile @relation(fields: [experienceProfileId], references: [id], onDelete: Cascade)
  tag               Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([experienceProfileId, tagId])
  @@index([tagId])
}

/// Current normalized event-binding projection. The complete authoritative
/// binding set is also frozen inside every ExperienceProfileVersion.
model ExperienceEventBinding {
  experienceProfileId String
  identifier          String
  eventType           String
  priority            Int      @default(0)
  binding             String
  createdAt           DateTime @default(now())

  experienceProfile ExperienceProfile @relation(fields: [experienceProfileId], references: [id], onDelete: Cascade)

  @@id([experienceProfileId, identifier])
  @@index([experienceProfileId, eventType])
}

model ExperienceAsset {
  experienceProfileId String
  identifier          String
  assetId              String
  assetVersion         Int
  role                 String
  createdAt            DateTime @default(now())

  experienceProfile ExperienceProfile @relation(fields: [experienceProfileId], references: [id], onDelete: Cascade)
  asset             Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([experienceProfileId, identifier])
  @@index([assetId])
  @@index([experienceProfileId, role])
}

model ExperienceEntity {
  experienceProfileId String
  entityId             String
  createdAt            DateTime @default(now())

  experienceProfile ExperienceProfile @relation(fields: [experienceProfileId], references: [id], onDelete: Cascade)
  entity            Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@id([experienceProfileId, entityId])
  @@index([entityId])
}

model ExperienceWorld {
  experienceProfileId String
  worldId              String
  worldVersion         Int
  createdAt            DateTime @default(now())

  experienceProfile ExperienceProfile @relation(fields: [experienceProfileId], references: [id], onDelete: Cascade)
  world             World             @relation(fields: [worldId], references: [id], onDelete: Restrict)

  @@id([experienceProfileId, worldId, worldVersion])
  @@index([worldId])
}

// ============================================================================
// TOURNAMENT SYSTEM (Parallel Platform Web Phase 4)
//
// Tournaments orchestrate normal Simulation definitions and SimulationRuns.
// Match results are immutable snapshots of authoritative module output; the
// Tournament never calculates a module winner itself.
// ============================================================================

model Tournament {
  id                            String    @id @default(cuid())
  workspaceId                   String
  projectId                     String?
  simulationTemplateId          String
  name                          String
  slug                          String
  description                   String?
  status                        String    @default("DRAFT")
  archivedFromStatus            String?
  format                        String
  participantType               String    @default("ENTITY")
  moduleKey                     String
  seedingMethod                 String
  randomSeed                    String
  tiePolicy                     String
  winPoints                     Int       @default(3)
  tiePoints                     Int       @default(1)
  lossPoints                    Int       @default(0)
  tiebreakers                   String
  scheduledStartAt              DateTime?
  worldId                       String?
  worldVersion                  Int?
  experienceProfileId           String?
  experienceProfileVersion      Int?
  simulationSnapshot            String?
  championParticipantId         String?
  tiedChampionParticipantIds    String?
  finalStandingsSnapshot        String?
  executionError                String?
  createdById                   String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  startedAt                     DateTime?
  pausedAt                      DateTime?
  completedAt                   DateTime?
  cancelledAt                   DateTime?
  archivedAt                    DateTime?

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  simulationTemplate Simulation         @relation("TournamentTemplateSimulation", fields: [simulationTemplateId], references: [id], onDelete: Restrict)
  world              World?             @relation(fields: [worldId], references: [id], onDelete: Restrict)
  experienceProfile  ExperienceProfile? @relation(fields: [experienceProfileId], references: [id], onDelete: Restrict)
  createdBy          User?              @relation("TournamentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants       TournamentParticipant[]
  rounds             TournamentRound[]
  matches            TournamentMatch[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, format])
  @@index([workspaceId, moduleKey])
  @@index([workspaceId, updatedAt])
  @@index([projectId])
  @@index([simulationTemplateId])
  @@index([worldId, worldVersion])
  @@index([experienceProfileId, experienceProfileVersion])
  @@index([createdById])
}

model TournamentParticipant {
  id               String   @id @default(cuid())
  tournamentId     String
  sourceType       String   @default("ENTITY")
  entityId         String
  displayName      String
  seed             Int
  position         Int
  status           String   @default("ACTIVE")
  teamMetadata     String?
  snapshotMetadata String?
  createdAt        DateTime @default(now())

  tournament       Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  entity           Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict)
  slotOneMatches   TournamentMatch[] @relation("TournamentMatchParticipantOne")
  slotTwoMatches   TournamentMatch[] @relation("TournamentMatchParticipantTwo")
  wonMatches       TournamentMatch[] @relation("TournamentMatchWinner")

  @@unique([tournamentId, entityId])
  @@unique([tournamentId, seed])
  @@unique([tournamentId, position])
  @@index([entityId])
  @@index([tournamentId, status])
}

model TournamentRound {
  id          String    @id @default(cuid())
  tournamentId String
  number      Int
  label       String
  state       String    @default("PENDING")
  startsAt    DateTime?
  completedAt DateTime?
  metadata    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    TournamentMatch[]

  @@unique([tournamentId, number])
  @@index([tournamentId, state])
}

model TournamentMatch {
  id                       String    @id @default(cuid())
  tournamentId             String
  roundId                  String
  matchNumber              Int
  state                    String    @default("PENDING")
  participantOneId         String?
  participantTwoId         String?
  winnerParticipantId      String?
  nextMatchId              String?
  nextSlot                 Int?
  replayOfMatchId          String?
  simulationId             String?   @unique
  simulationRunId          String?   @unique
  resultSnapshot           String?
  resultHash               String?
  scheduledAt              DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  metadata                 String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tournament      Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round           TournamentRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantOne  TournamentParticipant? @relation("TournamentMatchParticipantOne", fields: [participantOneId], references: [id], onDelete: Restrict)
  participantTwo  TournamentParticipant? @relation("TournamentMatchParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Restrict)
  winner          TournamentParticipant? @relation("TournamentMatchWinner", fields: [winnerParticipantId], references: [id], onDelete: Restrict)
  nextMatch       TournamentMatch?       @relation("TournamentMatchAdvancement", fields: [nextMatchId], references: [id], onDelete: SetNull)
  previousMatches TournamentMatch[]      @relation("TournamentMatchAdvancement")
  replayOf        TournamentMatch?       @relation("TournamentMatchReplay", fields: [replayOfMatchId], references: [id], onDelete: SetNull)
  replays         TournamentMatch[]      @relation("TournamentMatchReplay")
  simulation      Simulation?            @relation("TournamentMatchSimulation", fields: [simulationId], references: [id], onDelete: Restrict)
  simulationRun   SimulationRun?         @relation("TournamentMatchRun", fields: [simulationRunId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, matchNumber])
  @@index([tournamentId, state])
  @@index([roundId])
  @@index([participantOneId])
  @@index([participantTwoId])
  @@index([winnerParticipantId])
  @@index([nextMatchId])
  @@index([replayOfMatchId])
}

// ============================================================================
// PROJECT SYSTEM (Phase 2 — workspace-owned organizational container)
//
// A Project groups existing Entities and Simulations (and, in future phases,
// Worlds/Tournaments/Assets/Results/Content) for a body of work. Projects
// REFERENCE Entities through the ProjectEntity join table — they never clone an
// Entity record. Everything is workspace-scoped; a Project may only ever link
// Entities from its own workspace (enforced in the service layer, never trusting
// client IDs). Archiving or deleting a Project must never delete a shared Entity.
// ============================================================================

/// A workspace-owned container that organizes Entities and Simulations.
model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  slug        String // normalized, human-readable key (not unique; routes use the cuid id)
  description String?
  imageUrl    String?
  coverUrl    String?
  status      String    @default("ACTIVE") // ProjectStatus (ACTIVE|ARCHIVED) — validated in app layer
  metadata    String? // serialized JSON for flexible secondary data (portable across SQLite/Postgres)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entityLinks ProjectEntity[]
  simulations Simulation[]
  tournaments Tournament[]

  // Every index leads with workspaceId so all list/search/sort queries stay tenant-scoped.
  @@index([workspaceId, status])
  @@index([workspaceId, name])
  @@index([workspaceId, updatedAt])
  @@index([createdById])
}

/// Reference link between a Project and an existing Entity (many-to-many).
/// This is a link row, NEVER a copy of the Entity. Cascade here only removes the
/// LINK when either side is deleted — it never deletes the shared Entity itself.
model ProjectEntity {
  projectId String
  entityId  String
  addedById String?
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("ProjectEntityAdder", fields: [addedById], references: [id], onDelete: SetNull)

  // Composite PK doubles as the uniqueness guard: an Entity links to a Project at most once.
  @@id([projectId, entityId])
  @@index([entityId])
  @@index([addedById])
}

// ============================================================================
// SIMULATION DEFINITION SYSTEM (Phase 2 — configuration/blueprint only)
//
// A Simulation is a SAVED CONFIGURATION (a blueprint), NOT an execution. Runtime
// data belongs to SimulationRun below. `mode` is an
// open-ended slug (battle|race|tournament|survival|…) resolved by an app-layer
// Mode Catalog — there is no table or column per mode. Participants are generic
// (SimulationEntity), never fighter1Id/car1Id, and reference live Entities.
// ============================================================================

/// A saved simulation configuration/blueprint owned by a Project.
model Simulation {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String
  name          String
  description   String?
  mode          String // open-ended mode slug (battle|race|tournament|survival|…); labelled in app layer
  status        String    @default("DRAFT") // SimulationStatus (DRAFT|READY|ARCHIVED) — validated in app layer
  seed          String? // SV-XXXXXXXX label; resolved into a permanent run seed at execution
  configVersion Int       @default(1) // schema version of `configuration` (SimulationConfigV1)
  configuration String? // serialized JSON (SimulationConfigV1) — validated server-side, never trusted raw
  presentation  String? // serialized JSON (SimulationPresentationConfig) — stored separately from logic config
  worldId       String?
  worldVersion  Int?
  experienceProfileId      String?
  experienceProfileVersion Int?
  metadata      String? // serialized JSON for flexible secondary data
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("SimulationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entityLinks SimulationEntity[]
  runs        SimulationRun[]
  world       World?             @relation(fields: [worldId], references: [id], onDelete: Restrict)
  experienceProfile ExperienceProfile? @relation(fields: [experienceProfileId], references: [id], onDelete: Restrict)
  tournamentTemplates Tournament[]      @relation("TournamentTemplateSimulation")
  tournamentMatches   TournamentMatch[] @relation("TournamentMatchSimulation")

  @@index([workspaceId, projectId])
  @@index([workspaceId, mode])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@index([projectId])
  @@index([createdById])
  @@index([worldId, worldVersion])
  @@index([experienceProfileId, experienceProfileVersion])
}

/// Generic participant link between a Simulation and an existing Entity.
/// Ordering/role/overrides are configuration only. A run copies the participant's
/// complete execution input at creation; this link continues to reference the live Entity.
model SimulationEntity {
  simulationId String
  entityId     String
  position     Int      @default(0) // slot/order index within the simulation
  role         String? // optional participant role slug (app-layer meaning; no mechanics in Phase 2)
  overrides    String? // serialized JSON of per-participant config overrides/metadata
  addedAt      DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  entity     Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)

  // Composite PK doubles as the uniqueness guard: an Entity participates at most once.
  @@id([simulationId, entityId])
  @@index([entityId])
  @@index([simulationId, position])
}

// ============================================================================
// CORE EXECUTION (Phase 3 — generic runs, no product or mode mechanics)
//
// All JSON payloads are versioned, validated in Core, and stored as strings for
// SQLite/PostgreSQL portability. A Simulation with runs cannot be deleted: the
// Restrict relation preserves provenance even through Project deletion. Source
// Entity IDs on run participants are historical scalar values, not live FKs.
// ============================================================================

model SimulationRun {
  id                       String    @id @default(cuid())
  workspaceId              String
  simulationId             String
  status                   String    @default("CREATED")
  mode                     String
  resolvedSeed             String
  coreEngineVersion        String
  moduleId                 String
  moduleVersion            String
  rngAlgorithmVersion      String
  configVersion            Int
  configurationSnapshot    String
  presentationSnapshot     String
  inputSnapshotVersion     Int
  inputSnapshot            String
  stateVersion             Int
  state                    String
  fixedStepMs              Int
  currentTick              Int       @default(0)
  elapsedSimulationMs      Int       @default(0)
  lastActionSequence       Int       @default(0)
  lastEventSequence        Int       @default(0)
  resultVersion            Int       @default(1)
  result                   String?
  failureCode              String?
  failureMessage           String?
  createdById              String?
  createdAt                DateTime  @default(now())
  startedAt                DateTime?
  pausedAt                 DateTime?
  completedAt              DateTime?
  failedAt                 DateTime?
  cancelledAt              DateTime?
  updatedAt                DateTime  @updatedAt

  workspace   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  simulation  Simulation                 @relation(fields: [simulationId], references: [id], onDelete: Restrict)
  createdBy   User?                      @relation("RunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants SimulationRunParticipant[]
  actions      SimulationRunAction[]
  events       SimulationRunEvent[]
  tournamentMatch TournamentMatch?      @relation("TournamentMatchRun")
  mediaArtifacts  MediaArtifact[]

  @@index([workspaceId, simulationId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([simulationId])
  @@index([createdById])
}

model SimulationRunParticipant {
  id             String   @id @default(cuid())
  runId          String
  sourceEntityId String // historical ID, deliberately not a FK to the editable Entity
  position       Int
  role           String?
  snapshotVersion Int    @default(1)
  snapshot       String
  createdAt      DateTime @default(now())

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@index([runId, sourceEntityId])
}

model SimulationRunAction {
  id                    String   @id @default(cuid())
  runId                 String
  sequence              Int
  tick                  Int
  type                  String
  actorRunParticipantId String?
  targetRunParticipantId String?
  payloadVersion        Int
  payload               String
  createdAt             DateTime @default(now())

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, tick])
}

model SimulationRunEvent {
  id                    String   @id @default(cuid())
  runId                 String
  sequence              Int
  tick                  Int
  simulatedTimeMs       Int
  type                  String
  actorRunParticipantId String?
  targetRunParticipantId String?
  payloadVersion        Int
  payload               String
  createdAt             DateTime @default(now())

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, tick])
}

// ============================================================================
// CREATOR / MEDIA FOUNDATION v1
//
// MediaArtifact is a stable workspace-owned creative item derived from one
// completed authoritative Run. MediaArtifactVersion rows are immutable
// presentation snapshots. They never replace or modify Core Run truth.
// ============================================================================

model MediaArtifact {
  id                 String    @id @default(cuid())
  workspaceId        String
  sourceRunId        String
  type               String    @default("STORYBOARD")
  status             String    @default("DRAFT")
  currentVersion     Int       @default(1)
  archivedFromStatus String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceRun SimulationRun          @relation(fields: [sourceRunId], references: [id], onDelete: Restrict)
  createdBy User?                  @relation("MediaArtifactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions  MediaArtifactVersion[]
  share     MediaShare?

  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, type, updatedAt])
  @@index([sourceRunId])
  @@index([createdById])
}

model MediaArtifactVersion {
  id          String   @id @default(cuid())
  artifactId  String
  version     Int
  title       String
  subtitle    String?
  description String?
  aspectRatio String
  status      String
  storyboard  String
  createdById String?
  createdAt   DateTime @default(now())

  artifact MediaArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("MediaArtifactVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([artifactId, version])
  @@index([artifactId, createdAt])
  @@index([createdById])
}

// ============================================================================
// PUBLIC / UNLISTED SHARING v1
//
// MediaShare exposes one immutable MediaArtifactVersion through a stable,
// high-entropy publicId. Visibility is the single source of truth for public
// access (PRIVATE = not accessible). One share per artifact; sharing is always
// an explicit creator action and never mutates the pinned version.
// ============================================================================

model MediaShare {
  id              String   @id @default(cuid())
  workspaceId     String
  artifactId      String   @unique
  artifactVersion Int
  visibility      String   @default("PRIVATE")
  publicId        String   @unique
  titleOverride   String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifact  MediaArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("MediaShareCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, visibility, updatedAt])
}


// SIMVERSE ECONOMY LAB v1 — owner-scoped fictional closed-currency demonstration.
// This is intentionally independent from PlayerVirtualWallet / platform SVC.
// No purchase or currency exchange endpoints exist.
model EconomyLab {
  id          String @id @default(cuid())
  workspaceId String
  creatorId   String
  name        String
  stateJson   String
  access      String @default("PRIVATE") // PRIVATE or WORKSPACE (explicit creator opt-in)
  revision    Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User @relation("EconomyLabCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  transfers   EconomyLabTransfer[]
  @@index([workspaceId, creatorId])
}

model EconomyLabTransfer {
  id          String @id @default(cuid())
  labId       String
  sequence    Int
  day         Int
  fromAccount String
  toAccount   String
  amount      Int
  kind        String
  createdAt   DateTime @default(now())
  lab         EconomyLab @relation(fields: [labId], references: [id], onDelete: Cascade)
  @@unique([labId, sequence])
  @@index([labId, day])
}


// ============================================================================
// SIMVERSE COMMUNITY V1 — private, consent-based direct social interactions.
// One friendship row for an unordered pair; requested by one member and
// ACCEPTED only by the other. Blocking is always a separate hard veto.
// No public message feed or unscoped mailbox read.
// ============================================================================

model SocialFriendship {
  id String @id @default(cuid())
  pairKey String @unique
  senderId String
  receiverId String
  status String @default("PENDING") // PENDING | ACCEPTED (validated in service)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender User @relation("SocialFriendSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("SocialFriendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, status])
  @@index([receiverId, status])
}

model SocialBlock {
  id String @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker User @relation("SocialBlockOwner", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("SocialBlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model SocialMessage {
  id String @id @default(cuid())
  senderId String
  recipientId String
  body String
  createdAt DateTime @default(now())
  readAt DateTime?
  sender User @relation("SocialMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("SocialMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  reactions SocialReaction[]
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  @@index([recipientId, readAt, createdAt])
}

// Standalone keyframe animation editor. Records are scoped to the author
// AND their workspace; projects do not generate simulation results.
model AnimationProject {
  id String @id @default(cuid())
  ownerId String
  workspaceId String
  title String
  durationMs Int @default(5000)
  sceneJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("AnimationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([ownerId, workspaceId, updatedAt])
}

// COMMUNITY V2: consent-based private groups. Only accepted friends can be
// invited by a group member; invited accounts must accept before reading chat.
model SocialGroup {
  id String @id @default(cuid())
  title String
  ownerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("SocialGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members SocialGroupMember[]
  messages SocialGroupMessage[]
}
model SocialGroupMember {
  id String @id @default(cuid())
  groupId String
  userId String
  role String @default("MEMBER") // OWNER | MEMBER
  status String @default("INVITED") // INVITED | ACTIVE
  joinedAt DateTime?
  createdAt DateTime @default(now())
  group SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([groupId, userId])
  @@index([userId, status])
}
model SocialGroupMessage {
  id String @id @default(cuid())
  groupId String
  senderId String
  body String
  mediaUrl String?
  createdAt DateTime @default(now())
  group SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions SocialReaction[]
  @@index([groupId, createdAt])
}
model SocialReaction {
  id String @id @default(cuid())
  actorId String
  directMessageId String?
  groupMessageId String?
  emoji String
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  directMessage SocialMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  groupMessage SocialGroupMessage? @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)
  @@unique([actorId,directMessageId,emoji])
  @@unique([actorId,groupMessageId,emoji])
  @@index([directMessageId])
  @@index([groupMessageId])
}
model SocialNotification {
  id String @id @default(cuid())
  userId String
  kind String // FRIEND_INVITE | FRIEND_ACCEPTED | MESSAGE | GROUP_INVITE | GROUP_MESSAGE | CALL
  title String
  detail String
  href String
  createdAt DateTime @default(now())
  readAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId,readAt,createdAt])
}
// Expiring WebRTC signaling messages; intentionally no saved camera/microphone
// content. Calls need secure context + ICE, external TURN for reliable NAT.
model SocialCallSignal {
  id String @id @default(cuid())
  senderId String
  receiverId String
  callId String
  kind String // OFFER | ANSWER | ICE | HANGUP
  payload String
  createdAt DateTime @default(now())
  sender User @relation("CallSignalSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("CallSignalReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  @@index([receiverId, createdAt])
  @@index([callId,createdAt])
}
